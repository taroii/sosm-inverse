# paper stuff
paper/
notes/

# large run outputs
runs/

# source repos
multicomponent_code/
multicomponent_electrolyte_code/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Captured stdout. These are outputs, not sources, and an untracked file in the
# repo root trips runlog's dirty-tree guard.
*.log
bench.csv

# Firedrake / PETSc install, built inside the repo on the server.
# Must be ignored: runlog.Run refuses to launch from a dirty tree, and an
# untracked petsc/ or venv would block every run.
petsc/
venv-firedrake/
firedrake-configure
.firedrake-env

# Firedrake / PETSc artefacts
*.pvd
*.vtu
*.pvtu
*.h5
